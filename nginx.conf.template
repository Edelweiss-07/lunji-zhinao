worker_processes 1;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    sendfile on;
    client_max_body_size 50m;
    proxy_connect_timeout 60s;
    proxy_send_timeout 86400;
    proxy_read_timeout 86400;

    server {
        # HF 会注入 $PORT（默认 7860）；envsubst 只替换 ${PORT}
        listen ${PORT};

        # Render 注入 PORT=10000 会让 nginx 内部 301 Location 带端口
        # (e.g. http://host:10000/ai/)，浏览器跟随后直连 10000 会 timeout
        # 关闭端口重定向，让 Location 用相对路径，浏览器自动用原 host:port
        port_in_redirect off;
        absolute_redirect off;

        # ---- Gradio 演示（7861）----
        # 注意：Gradio 设了 root_path="/demo"，proxy_pass 不能带末尾斜杠，
        # 否则 /demo 前缀会被剥离，Gradio 收到 /queue/join 而与 root_path 不匹配
        location /demo/ {
            proxy_pass http://127.0.0.1:7861;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
        location /demo {
            return 301 /demo/;
        }

        # ---- 视觉诊断智能体（7864）----
        location = /ai {
            # /ai 不带尾斜杠直接重写到 7862 静态资源，避开 7864 没有 / 路由的 501
            rewrite ^ /static/cooling-diagnosis.html break;
            proxy_pass http://127.0.0.1:7862;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }
        location /ai/ {
            proxy_pass http://127.0.0.1:7864/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # ---- 告警桥（7863，HF 上未运行，失败无害）----
        location /alert/ {
            proxy_pass http://127.0.0.1:7863/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # ---- 默认：FastAPI 网关（7862，落地页/静态资源/历史）----
        location / {
            proxy_pass http://127.0.0.1:7862;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
